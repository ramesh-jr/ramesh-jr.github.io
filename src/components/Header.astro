---
import { profile, nav } from '../data/profile';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="/">{profile.shortName}</a>
    <nav class="site-header__nav" aria-label="Primary">
      {nav.map((item) => <a class="site-header__link" href={item.href}>{item.label}</a>)}
      <button type="button" class="site-header__search" data-palette-open hidden>
        Search <kbd data-mod-key>Ctrl K</kbd>
      </button>
      <button type="button" class="site-header__theme" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
        <svg class="icon icon--moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
        </svg>
        <svg class="icon icon--sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 32px;
    padding-block: 12px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 24px;
    font-size: 15px;
  }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .site-header__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--fg);
  }
  .site-header__search {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    /* Keyboard hints mean nothing on a phone. */
    .site-header__search kbd {
      display: none;
    }
  }
  kbd {
    padding: 2px 6px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    color: var(--muted);
  }
  .site-header__theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .site-header__theme:hover {
    background: var(--surface);
  }
  /* Show the icon for the theme you would switch TO. */
  .icon--sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon--sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon--moon {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const isDark = () => root.dataset.theme === 'dark';

  function sync() {
    toggle?.setAttribute('aria-pressed', String(isDark()));
  }

  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be unavailable (private mode); the choice just won't persist.
    }
    sync();
  });
  sync();
</script>
