---
import { profile, nav } from '../data/profile';

interface Command {
  id: string;
  label: string;
  group: 'Go to' | 'Action';
  href?: string;
  external?: boolean;
  action?: 'theme';
}

const commands: Command[] = [
  ...nav.map((item) => ({
    id: `go-${item.label.toLowerCase()}`,
    label: item.label === 'Work' ? 'Selected work' : item.label,
    group: 'Go to' as const,
    href: item.href,
  })),
  { id: 'theme', label: 'Toggle dark or light theme', group: 'Action', action: 'theme' },
  { id: 'email', label: 'Send an email', group: 'Action', href: `mailto:${profile.email}` },
  { id: 'linkedin', label: 'Open LinkedIn', group: 'Action', href: profile.linkedin, external: true },
  { id: 'github', label: 'Open GitHub', group: 'Action', href: profile.github, external: true },
  ...(profile.resumeUrl
    ? [{ id: 'resume', label: 'Download resume (PDF)', group: 'Action' as const, href: profile.resumeUrl }]
    : []),
];
---

<dialog class="palette" data-palette aria-label="Command palette">
  <div class="palette__bar">
    <input
      class="palette__input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Search commands"
      placeholder="Jump to…"
      autocomplete="off"
      spellcheck="false"
    />
    <kbd>esc</kbd>
  </div>
  <ul class="palette__list" id="palette-list" role="listbox" aria-label="Commands">
    {
      commands.map((c) => (
        <li
          role="option"
          id={`cmd-${c.id}`}
          aria-selected="false"
          data-label={c.label.toLowerCase()}
          data-href={c.href}
          data-external={c.external ? '' : undefined}
          data-action={c.action}
        >
          <span>{c.label}</span>
          <small>{c.group}</small>
        </li>
      ))
    }
  </ul>
  <p class="palette__empty" hidden>No matches</p>
</dialog>

<style>
  .palette {
    width: min(560px, calc(100vw - 32px));
    max-height: min(480px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--surface);
    color: var(--fg);
    overflow: hidden;
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.25);
  }
  .palette[open] {
    display: flex;
    flex-direction: column;
  }
  .palette::backdrop {
    background: rgb(10 10 14 / 0.5);
    backdrop-filter: blur(2px);
  }
  .palette__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
  }
  .palette__input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 17px;
  }
  .palette__input:focus-visible {
    outline: none;
  }
  .palette__list {
    margin: 0;
    padding: 8px;
    list-style: none;
    overflow-y: auto;
  }
  .palette__list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
  }
  .palette__list li[aria-selected='true'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .palette__list small {
    color: var(--muted);
    font-size: 13px;
  }
  .palette__empty {
    padding: 16px 20px 24px;
    color: var(--muted);
  }
  kbd {
    padding: 2px 6px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    color: var(--muted);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');

  if (dialog && typeof dialog.showModal === 'function') {
    const input = dialog.querySelector<HTMLInputElement>('input')!;
    const list = dialog.querySelector<HTMLUListElement>('ul')!;
    const empty = dialog.querySelector<HTMLElement>('.palette__empty')!;
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));
    let active = 0;

    const visible = () => items.filter((li) => !li.hidden);

    function setActive(index: number) {
      const shown = visible();
      items.forEach((li) => li.setAttribute('aria-selected', 'false'));
      if (shown.length === 0) {
        input.removeAttribute('aria-activedescendant');
        return;
      }
      active = (index + shown.length) % shown.length;
      const li = shown[active];
      li.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', li.id);
      li.scrollIntoView({ block: 'nearest' });
    }

    function filter() {
      const query = input.value.trim().toLowerCase();
      items.forEach((li) => {
        li.hidden = query !== '' && !(li.dataset.label ?? '').includes(query);
      });
      empty.hidden = visible().length > 0;
      setActive(0);
    }

    function open() {
      input.value = '';
      filter();
      dialog!.showModal();
      input.focus();
    }

    function run(li: HTMLLIElement) {
      dialog!.close();
      if (li.dataset.action === 'theme') {
        document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
        return;
      }
      const href = li.dataset.href;
      if (!href) return;
      if (li.dataset.external !== undefined) {
        window.open(href, '_blank', 'noopener,noreferrer');
      } else {
        location.href = href;
      }
    }

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const current = visible()[active];
        if (current) run(current);
      }
    });

    list.addEventListener('click', (event) => {
      const li = (event.target as HTMLElement).closest('li');
      if (li) run(li as HTMLLIElement);
    });

    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });

    // Without JS the trigger stays hidden; with it, reveal and wire it up.
    const isApple = /Mac|iPhone|iPad/i.test(navigator.userAgent);
    document.querySelectorAll<HTMLElement>('[data-mod-key]').forEach((el) => {
      el.textContent = isApple ? '⌘K' : 'Ctrl K';
    });
    document.querySelectorAll<HTMLElement>('[data-palette-open]').forEach((el) => {
      el.hidden = false;
      el.addEventListener('click', open);
    });
  }
</script>
